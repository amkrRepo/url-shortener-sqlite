generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Url {
  id           Int      @id @default(autoincrement())
  original_url String   @unique
  short_code   String   @unique
  created_at   DateTime @default(now())

  @@index([short_code, created_at])
}
